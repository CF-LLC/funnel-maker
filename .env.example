# Copy to .env.local (dev) or .env (docker compose). Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase publishable (anon) key. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Server-only. Used by the admin approval route. Never expose to the browser.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=https://funnels.spockshop.com
NEXT_PUBLIC_SITE_URL=https://funnels.spockshop.com

# Optional. The app builds and runs without these; the related routes return errors until set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
RESEND_API_KEY=
OPENAI_API_KEY=

# Cloudflare Turnstile (optional; bot check is skipped when unset).
# For signup, also enable Turnstile under Supabase > Auth > Attack Protection with the same secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Starter Sites footer link on public funnel pages (?ref=funnel-maker&tpl=<template> is appended).
NEXT_PUBLIC_STARTER_SITES_URL=https://cf-llc.github.io/
