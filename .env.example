# Copy to .env.local (dev) or .env (docker compose). Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase publishable (anon) key. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Server-only. Used by the admin approval route. Never expose to the browser.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=https://saasnation.site
# Canonical site. funnels.saasnation.site 301-redirects here (except /api/stripe/webhook, /healthz). Rebuild after changing.
NEXT_PUBLIC_SITE_URL=https://saasnation.site

# Optional. The app builds and runs without these; the related routes return errors until set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe webhook (POST /api/stripe/webhook). JSON map of price ids or payment link ids to tools, e.g.
# {"price_123":{"tool":"funnels","plan":"monthly"},"plink_456":{"tool":"all","plan":"yearly"}}
# Proposals (placeholder, no Stripe product yet): add e.g. "plink_PROPOSALS_MONTHLY":{"tool":"proposals","plan":"monthly"} and "plink_PROPOSALS_YEARLY":{"tool":"proposals","plan":"yearly"} once the links exist.
# Testimonials (placeholder, no Stripe product yet): add e.g. "plink_TESTIMONIALS_MONTHLY":{"tool":"testimonials","plan":"monthly"} and "plink_TESTIMONIALS_YEARLY":{"tool":"testimonials","plan":"yearly"} once the links exist.
STRIPE_PRICE_MAP=
# Set to false once invoices launches to stop granting founding invoices access on approval/checkout.
INVOICES_FOUNDING_OPEN=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
RESEND_API_KEY=
OPENAI_API_KEY=

# Cloudflare Turnstile (optional; bot check is skipped when unset).
# For signup, also enable Turnstile under Supabase > Auth > Attack Protection with the same secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Starter Sites footer link on public funnel pages (?ref=funnel-maker&tpl=<template> is appended).
# Starter Sites page, base URL only (no query string; ref/tpl are added by the app). Empty = https://cf-llc.github.io/
NEXT_PUBLIC_STARTER_SITES_URL=

# Stripe Payment Links on CF LLC's Stripe account. Buttons show "Checkout opening soon" until set.
# Must be https://buy.stripe.com/... links. Inlined at BUILD time: rebuild the image after changing.
# The app appends client_reference_id=<supabase user id> and prefilled_email=<user email> for signed-in users.
# In Stripe, set each link's after-payment redirect to https://saasnation.site/dashboard?checkout=success
# (shows a "Payment received" banner). Activation is manual: match the payment's client_reference_id in Stripe,
# then set plan + paid-through and approve on /dashboard/admin/approvals. No webhook in v1.
NEXT_PUBLIC_STRIPE_LINK_MONTHLY=
NEXT_PUBLIC_STRIPE_LINK_YEARLY=
NEXT_PUBLIC_STRIPE_LINK_FOUNDING=
