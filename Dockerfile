ARG NEXT_PUBLIC_STRIPE_LINK_PAID_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LINK_PAID_YEARLY
ARG NEXT_PUBLIC_STRIPE_LINK_FORMS_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LINK_FORMS_YEARLY
ARG NEXT_PUBLIC_STRIPE_LINK_FOUNDING
ARG NEXT_PUBLIC_STRIPE_LINK_INVOICES_MONTHLY
