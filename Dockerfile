    NEXT_PUBLIC_STRIPE_LINK_APPROVALS_YEARLY=${NEXT_PUBLIC_STRIPE_LINK_APPROVALS_YEARLY} \
    NEXT_PUBLIC_STRIPE_LINK_CHANGELOG_MONTHLY=${NEXT_PUBLIC_STRIPE_LINK_CHANGELOG_MONTHLY} \
    NEXT_PUBLIC_STRIPE_LINK_CHANGELOG_YEARLY=${NEXT_PUBLIC_STRIPE_LINK_CHANGELOG_YEARLY} \
    NEXT_PUBLIC_STRIPE_LINK_TIME_MONTHLY=${NEXT_PUBLIC_STRIPE_LINK_TIME_MONTHLY} \
    NEXT_PUBLIC_STRIPE_LINK_TIME_YEARLY=${NEXT_PUBLIC_STRIPE_LINK_TIME_YEARLY} \
    NEXT_PUBLIC_EXPENSES_ENABLED=${NEXT_PUBLIC_EXPENSES_ENABLED} \
    NEXT_PUBLIC_STRIPE_LINK_EXPENSES_MONTHLY=${NEXT_PUBLIC_STRIPE_LINK_EXPENSES_MONTHLY} \
