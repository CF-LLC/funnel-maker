ARG NEXT_PUBLIC_STRIPE_LINK_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LINK_PROPOSALS_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LINK_PROPOSALS_YEARLY
ARG NEXT_PUBLIC_STRIPE_LINK_TESTIMONIALS_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LINK_TESTIMONIALS_YEARLY
ARG NEXT_PUBLIC_STRIPE_LINK_YEARLY
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPPORT_EMAIL
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL} \
    NEXT_PUBLIC_CRM_ENABLED=${NEXT_PUBLIC_CRM_ENABLED} \
    NEXT_PUBLIC_EMAILLIST_ENABLED=${NEXT_PUBLIC_EMAILLIST_ENABLED} \
    NEXT_PUBLIC_DOWNLOADS_ENABLED=${NEXT_PUBLIC_DOWNLOADS_ENABLED} \
    NEXT_PUBLIC_PORTAL_ENABLED=${NEXT_PUBLIC_PORTAL_ENABLED} \
    NEXT_PUBLIC_APPROVALS_ENABLED=${NEXT_PUBLIC_APPROVALS_ENABLED} \
    NEXT_PUBLIC_CHANGELOG_ENABLED=${NEXT_PUBLIC_CHANGELOG_ENABLED} \
    NEXT_PUBLIC_TIMETRACKING_ENABLED=${NEXT_PUBLIC_TIMETRACKING_ENABLED} \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    NEXT_PUBLIC_STARTER_SITES_URL=${NEXT_PUBLIC_STARTER_SITES_URL} \
    NEXT_PUBLIC_STRIPE_LINK_ALL_MONTHLY=${NEXT_PUBLIC_STRIPE_LINK_ALL_MONTHLY} \
    NEXT_PUBLIC_STRIPE_LINK_ALL_YEARLY=${NEXT_PUBLIC_STRIPE_LINK_ALL_YEARLY} \
