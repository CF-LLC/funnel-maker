    NEXT_PUBLIC_STRIPE_LINK_CRM_YEARLY=${NEXT_PUBLIC_STRIPE_LINK_CRM_YEARLY} \
    NEXT_PUBLIC_STRIPE_LINK_EMAILLIST_MONTHLY=${NEXT_PUBLIC_STRIPE_LINK_EMAILLIST_MONTHLY} \
    NEXT_PUBLIC_STRIPE_LINK_EMAILLIST_YEARLY=${NEXT_PUBLIC_STRIPE_LINK_EMAILLIST_YEARLY} \
    NEXT_PUBLIC_STRIPE_LINK_DOWNLOADS_MONTHLY=${NEXT_PUBLIC_STRIPE_LINK_DOWNLOADS_MONTHLY} \
    NEXT_PUBLIC_STRIPE_LINK_DOWNLOADS_YEARLY=${NEXT_PUBLIC_STRIPE_LINK_DOWNLOADS_YEARLY} \
    NEXT_PUBLIC_STRIPE_LINK_PORTAL_MONTHLY=${NEXT_PUBLIC_STRIPE_LINK_PORTAL_MONTHLY} \
