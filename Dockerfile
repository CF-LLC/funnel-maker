# syntax=docker/dockerfile:1
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:20-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_CRM_ENABLED
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_STARTER_SITES_URL
ARG NEXT_PUBLIC_STRIPE_LINK_ALL_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LINK_ALL_YEARLY
ARG NEXT_PUBLIC_STRIPE_LINK_BOOKING_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LINK_BOOKING_YEARLY
ARG NEXT_PUBLIC_STRIPE_LINK_DATAREMOVAL_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LINK_DATAREMOVAL_YEARLY
ARG NEXT_PUBLIC_STRIPE_LINK_FORMS_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LINK_FORMS_YEARLY
ARG NEXT_PUBLIC_STRIPE_LINK_FOUNDING
ARG NEXT_PUBLIC_STRIPE_LINK_INVOICES_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LINK_INVOICES_YEARLY
ARG NEXT_PUBLIC_STRIPE_LINK_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LINK_PROPOSALS_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LINK_PROPOSALS_YEARLY
ARG NEXT_PUBLIC_STRIPE_LINK_TESTIMONIALS_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LINK_TESTIMONIALS_YEARLY
ARG NEXT_PUBLIC_STRIPE_LINK_YEARLY
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPPORT_EMAIL
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL} \
    NEXT_PUBLIC_CRM_ENABLED=${NEXT_PUBLIC_CRM_ENABLED} \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    NEXT_PUBLIC_STARTER_SITES_URL=${NEXT_PUBLIC_STARTER_SITES_URL} \
    NEXT_PUBLIC_STRIPE_LINK_ALL_MONTHLY=${NEXT_PUBLIC_STRIPE_LINK_ALL_MONTHLY} \
    NEXT_PUBLIC_STRIPE_LINK_ALL_YEARLY=${NEXT_PUBLIC_STRIPE_LINK_ALL_YEARLY} \
    NEXT_PUBLIC_STRIPE_LINK_BOOKING_MONTHLY=${NEXT_PUBLIC_STRIPE_LINK_BOOKING_MONTHLY} \
    NEXT_PUBLIC_STRIPE_LINK_BOOKING_YEARLY=${NEXT_PUBLIC_STRIPE_LINK_BOOKING_YEARLY} \
    NEXT_PUBLIC_STRIPE_LINK_DATAREMOVAL_MONTHLY=${NEXT_PUBLIC_STRIPE_LINK_DATAREMOVAL_MONTHLY} \
    NEXT_PUBLIC_STRIPE_LINK_DATAREMOVAL_YEARLY=${NEXT_PUBLIC_STRIPE_LINK_DATAREMOVAL_YEARLY} \
    NEXT_PUBLIC_STRIPE_LINK_FORMS_MONTHLY=${NEXT_PUBLIC_STRIPE_LINK_FORMS_MONTHLY} \
    NEXT_PUBLIC_STRIPE_LINK_FORMS_YEARLY=${NEXT_PUBLIC_STRIPE_LINK_FORMS_YEARLY} \
    NEXT_PUBLIC_STRIPE_LINK_FOUNDING=${NEXT_PUBLIC_STRIPE_LINK_FOUNDING} \
    NEXT_PUBLIC_STRIPE_LINK_INVOICES_MONTHLY=${NEXT_PUBLIC_STRIPE_LINK_INVOICES_MONTHLY} \
    NEXT_PUBLIC_STRIPE_LINK_INVOICES_YEARLY=${NEXT_PUBLIC_STRIPE_LINK_INVOICES_YEARLY} \
    NEXT_PUBLIC_STRIPE_LINK_MONTHLY=${NEXT_PUBLIC_STRIPE_LINK_MONTHLY} \
    NEXT_PUBLIC_STRIPE_LINK_PROPOSALS_MONTHLY=${NEXT_PUBLIC_STRIPE_LINK_PROPOSALS_MONTHLY} \
    NEXT_PUBLIC_STRIPE_LINK_PROPOSALS_YEARLY=${NEXT_PUBLIC_STRIPE_LINK_PROPOSALS_YEARLY} \
    NEXT_PUBLIC_STRIPE_LINK_TESTIMONIALS_MONTHLY=${NEXT_PUBLIC_STRIPE_LINK_TESTIMONIALS_MONTHLY} \
    NEXT_PUBLIC_STRIPE_LINK_TESTIMONIALS_YEARLY=${NEXT_PUBLIC_STRIPE_LINK_TESTIMONIALS_YEARLY} \
    NEXT_PUBLIC_STRIPE_LINK_YEARLY=${NEXT_PUBLIC_STRIPE_LINK_YEARLY} \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY} \
    NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL} \
    NEXT_PUBLIC_SUPPORT_EMAIL=${NEXT_PUBLIC_SUPPORT_EMAIL} \
    NEXT_PUBLIC_TURNSTILE_SITE_KEY=${NEXT_PUBLIC_TURNSTILE_SITE_KEY}
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:20-alpine AS run
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup -S app && adduser -S app -G app
COPY --from=build --chown=app:app /app/.next/standalone ./
COPY --from=build --chown=app:app /app/.next/static ./.next/static
COPY --from=build --chown=app:app /app/public ./public
USER app
EXPOSE 3000
CMD ["node", "server.js"]
