ARG NEXT_PUBLIC_STRIPE_LINK_TIME_YEARLY
ARG NEXT_PUBLIC_EXPENSES_ENABLED
ARG NEXT_PUBLIC_STRIPE_LINK_EXPENSES_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LINK_EXPENSES_YEARLY
ARG NEXT_PUBLIC_REPORTS_ENABLED
ARG NEXT_PUBLIC_STRIPE_LINK_REPORTS_MONTHLY
ARG NEXT_PUBLIC_STRIPE_LINK_REPORTS_YEARLY
